# Trace logs / generated experiment artefacts (regenerable, keep small)
*.log
charts*/
# Eval artefacts under docs/charts/ are explicit history we want tracked
# (standalone results + integration re-eval). Without this exception
# the `charts*/` rule above would block them.
!docs/charts/
!docs/charts/**

# Python distribution
build/
dist/
*.egg-info/

# Integration source snapshots — frozen copies of team branches (also on GitHub
# as separate branches). Local-only working copy per MERGE_NOTES "원본 보호 원칙".
# Excluded to avoid duplicating committed branches AND to prevent re-committing
# old leaked API key strings inside legacy team source files.
integration/_sources/

# Lecture-provided reference material (stock xv6, week-N assignments, etc.).
# Kept locally as a read-only reference for parts (e.g. mkfs.c) we sometimes
# pull from. Not part of this project's deliverable; excluded so `git add .`
# can never accidentally commit external course material to our repo.
lecture-repo/

# On-device fine-tuned model weights copied into integration/ for the local
# backend (nlos.py DEFAULT_MODEL). ~472MB LoRA adapter — never commit; reproduce
# via ml/scripts/train.py or copy from the "LLM for OS" reference tree.
integration/ml/models/

# "LLM for OS" — frozen standalone snapshot of the teammate's NL-shell project
# (extracted .zip, includes __MACOSX cruft and a ~479MB Qwen-3B LoRA weight).
# The relevant pieces were ported into integration/; this 500MB source tree is a
# local-only reference and must never be committed (model weights, fs.img, .o).
LLM for OS/
