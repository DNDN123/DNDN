# Upstage Solar API
# Get key: https://www.upstage.ai/events/ai-initiative-2025-ko
#
# IMPORTANT: this is a TEMPLATE. Real keys live in `.env` (gitignored).
# NEVER replace the placeholder below with a real key in this file —
# `.env.example` is committed to git. If you accidentally commit a real
# key here, follow `docs/security-policy.md` (revoke + reissue).

UPSTAGE_API_KEY=your_api_key_here
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro3

# Reasoning effort for Solar Pro 3 reasoning model:
#   low    — fastest; usually enough for structured tasks like
#            "classify into 3 queue levels". Default.
#   medium — moderate thinking budget.
#   high   — more deliberate reasoning for complex chains.
UPSTAGE_REASONING_EFFORT=low
